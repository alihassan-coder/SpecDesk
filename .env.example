# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# FastAPI base URL the /api/v1/* proxy forwards to (server-side only)
API_URL=http://localhost:8000
# Sign-in emails via Brevo (https://app.brevo.com → SMTP & API → API keys). Empty in dev = code printed in the terminal.
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders, domains & dedicated IPs → Senders)
EMAIL_FROM_ADDRESS=hello@yourdomain.com
EMAIL_FROM_NAME=SpecDesk
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/alihassan-plotap/free-call

# ---- Shared ----
DATABASE_URL=
# Direct (non-pooled) URL for Alembic migrations (same host without "-pooler")
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
ADMIN_EMAILS=alihassan.coder@gmail.com

# ---- API (apps/api) ----
# development | test | preview | production
ENVIRONMENT=development
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Better Auth JWT verification (iss = aud = BETTER_AUTH_URL)
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
# Encrypts API keys saved from the admin panel. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# AI provider keys. Keys saved in Admin → API keys take priority over these.
# Default models live in the model catalog (Admin → AI models), not here.
# Groq is the default provider for now (https://console.groq.com/keys).
GROQ_API_KEY=
# Optional, switched off in the default catalog until an admin enables it:
ANTHROPIC_API_KEY=
CALENDLY_WEBHOOK_SIGNING_KEY=

# ---- Optional: LangSmith tracing for the agents (https://smith.langchain.com) ----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=specdesk
